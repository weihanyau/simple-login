---
import Layout from "../layouts/Layout.astro";

const rawUrls = import.meta.env.PUBLIC_API_URLS ?? "";
const apiUrls = rawUrls
	.split(",")
	.map((u) => u.trim())
	.filter(Boolean)
	.map((apiUrl, i) => ({ apiUrl, path: `/domain-${i + 1}/` }));
---

<Layout title="Simple Login Demo">
	<main>
		<h1>Simple Login Demo</h1>
		<p class="hint">
			One demo page per API URL configured in <code>PUBLIC_API_URLS</code>:
		</p>
		<ul>
			{apiUrls.map(({ apiUrl, path }) => (
				<li>
					<a href={path}>{path}</a> → <code>{apiUrl}</code>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
		font-family: system-ui, sans-serif;
	}
	h1 {
		text-align: center;
	}
	.hint {
		color: #666;
	}
	code {
		word-break: break-all;
	}
</style>
