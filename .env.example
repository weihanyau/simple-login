# Comma-separated list of origins allowed by the backend CORS config
CORS_ORIGIN=http://localhost:4321

# URLs the browser uses to reach the API, comma-separated. One demo page is
# generated per entry at build time (/domain-1, /domain-2, ...)
PUBLIC_API_URLS=http://localhost:3001

# Host ports (optional)
BACKEND_PORT=3001
FRONTEND_PORT=4321

# Hosts allowed to reach the frontend dev/preview server.
# Set to "true" to allow all hosts, or a comma-separated list, e.g.:
# ALLOWED_HOSTS=test.weihanyau.qzz.io
ALLOWED_HOSTS=

# Note: auth uses an Authorization Bearer header, not cookies — no cookie
# or proxy configuration is needed for cross-site deployments.
