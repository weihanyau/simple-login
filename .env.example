# Comma-separated list of origins allowed by the backend CORS config
CORS_ORIGIN=http://localhost:4321

# URL the browser uses to reach the API (baked into the frontend at build time)
PUBLIC_API_URL=http://localhost:3001

# Host ports (optional)
BACKEND_PORT=3001
FRONTEND_PORT=4321

# Hosts allowed to reach the frontend dev/preview server.
# Set to "true" to allow all hosts, or a comma-separated list, e.g.:
# ALLOWED_HOSTS=test.weihanyau.qzz.io
ALLOWED_HOSTS=

# Cookie / proxy settings for the backend. Required when serving over HTTPS
# or with frontend and API on different (cross-site) origins:
COOKIE_SECURE=false          # true when served over HTTPS
COOKIE_SAMESITE=lax          # "none" for cross-site (requires COOKIE_SECURE=true)
TRUST_PROXY=false            # true when behind a reverse proxy (nginx, Cloudflare...)
